{
  "name": "@masterdns/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rotation": {
      "types": "./dist/rotation.d.ts",
      "default": "./dist/rotation.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "default": "./dist/cloud.js"
    },
    "./cloud-rotation-limits": {
      "types": "./dist/cloud-rotation-limits.d.ts",
      "default": "./dist/cloud-rotation-limits.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
