{
  "name": "@masterdns/cloud-providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests",
    "test:aws-e2e": "tsx scripts/aws-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1136.0",
    "@aws-sdk/client-ec2": "^3.1131.0",
    "@aws-sdk/client-lightsail": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.1131.0",
    "@aws-sdk/credential-providers": "^3.1131.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@masterdns/contracts": "workspace:*",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": { "tsx": "^4.23.1" }
}
