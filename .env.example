# Runtime
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
LOG_LEVEL=info

# Database and queue
DATABASE_URL=postgres://masterdns:masterdns@postgres:5432/masterdns
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# Bootstrap administrator (used only when no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Reverse proxy CIDRs whose forwarded headers may be trusted
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional real provider E2E test credentials. Never commit this value.
MASTERDNS_E2E_CLOUDFLARE_API_TOKEN=
MASTERDNS_E2E_CLOUDFLARE_ZONE=
