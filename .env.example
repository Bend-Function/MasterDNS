# Runtime
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
LOG_LEVEL=info
HEALTH_RAW_RETENTION_DAYS=30
HEALTH_STATS_RETENTION_DAYS=365
PROVIDER_SYNC_INTERVAL_SECONDS=300
PROVIDER_SYNC_SCAN_SECONDS=30

# Database and queue
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgres://masterdns:change-this-database-password@postgres:5432/masterdns
REDIS_URL=redis://redis:6379
WEB_PORT=3000
API_PORT=4000

# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# Bootstrap administrator (used only when no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Reverse proxy CIDRs whose forwarded headers may be trusted
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional real provider E2E test credentials. Never commit this value.
MASTERDNS_E2E_CLOUDFLARE_API_TOKEN=
MASTERDNS_E2E_CLOUDFLARE_ZONE=
